{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agenttrace:benchmark-task:v1",
  "title": "AgentTrace benchmark task v1",
  "description": "Evaluator-owned manifest for one immutable small-Python software-maintenance task.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "repository",
    "base_commit",
    "task_type",
    "title",
    "description",
    "visible_test_command",
    "hidden_test_command",
    "allowed_paths",
    "forbidden_paths",
    "timeout_seconds",
    "difficulty",
    "tags"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 100,
      "description": "Stable unique identifier; lowercase letters, digits, dots, underscores, and hyphens only."
    },
    "repository": {
      "description": "Canonical HTTPS Git URL or portable relative local-repository path. Credentials, query strings, fragments, and absolute host paths are forbidden.",
      "oneOf": [
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/]*@)[^\\s/?#@]+(?::[0-9]{1,5})?/[^\\s?#]+$",
          "maxLength": 500
        },
        {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!\\./)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[*?\\[\\]])[^\\u0000\\r\\n]+$",
          "minLength": 1,
          "maxLength": 300
        }
      ]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full lowercase 40-hex Git commit object ID; branches and tags are not accepted."
    },
    "task_type": {
      "type": "string",
      "enum": ["bug_fix", "refactor"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 4000,
      "pattern": "^[^\\u0000]+$"
    },
    "visible_test_command": {
      "$ref": "#/$defs/command"
    },
    "hidden_test_command": {
      "$ref": "#/$defs/command"
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "forbidden_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryPath"
      }
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900,
      "description": "Per-command wall-clock limit used consistently across configurations."
    },
    "difficulty": {
      "type": "string",
      "enum": ["easy", "medium", "hard"]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 1,
        "maxLength": 40
      }
    }
  },
  "$defs": {
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\u0000\\r\\n]+$",
      "description": "Trusted evaluator-authored command. Schema validity is not execution authorization."
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\./)(?!\\.$)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[*?\\[\\]])[^\\u0000\\r\\n]+$",
      "description": "Repository-relative POSIX file or directory prefix; no absolute path, parent traversal, backslash, or glob metacharacter."
    }
  }
}
