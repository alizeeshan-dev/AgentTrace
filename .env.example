# Relative runtime paths keep generated databases, workspaces, and artifacts local.
AGENTTRACE_ENVIRONMENT=development
AGENTTRACE_LOG_LEVEL=INFO
AGENTTRACE_STATE_DIR=.agenttrace
AGENTTRACE_MAX_FILE_SIZE_BYTES=1048576
AGENTTRACE_MAX_ARTIFACT_SIZE_BYTES=16777216
# Build docker/verification/Dockerfile under this local image tag before verification.
AGENTTRACE_VERIFICATION_IMAGE=agentrace-verifier:phase6
AGENTTRACE_VERIFICATION_CPUS=1.0
AGENTTRACE_VERIFICATION_MEMORY_MB=512
AGENTTRACE_VERIFICATION_PIDS=128
AGENTTRACE_VERIFICATION_TMPFS_MB=64
